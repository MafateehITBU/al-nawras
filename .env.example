# =============================================================================
# Al Nawras Intellectual Property — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in the values for local development.
# Never commit `.env` or any file containing real credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL via Neon)
# -----------------------------------------------------------------------------
# Pooled connection string for application queries (serverless-friendly).
# Use Neon's pooled connection URL (typically includes `-pooler` in the host).
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Direct connection string for Prisma migrations and schema operations.
# Use Neon's direct (non-pooled) connection URL.
DIRECT_URL="postgresql://user:password@host/database?sslmode=require"

# -----------------------------------------------------------------------------
# Cloudinary (Media & File Storage)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Secret used to sign session tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Public URL of the application (admin emails, internal links, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Public website URL (SEO metadata, sitemap, Open Graph). Usually matches APP_URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional — override default super admin credentials during seed
# SEED_SUPER_ADMIN_EMAIL="admin@alnawras.com"
# SEED_SUPER_ADMIN_PASSWORD="change-me"
