// Al Nawras Intellectual Property — Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum Permission {
  MANAGE_ADMINS
  MANAGE_BLOGS
  MANAGE_SERVICES
  MANAGE_CONTACT_ENQUIRIES
  MANAGE_WEBSITE_SETTINGS
}

enum EnquiryStatus {
  NEW
  READ
  ARCHIVED
}

enum SocialPlatform {
  LINKEDIN
  FACEBOOK
  INSTAGRAM
  X
}

// ─── Admins ──────────────────────────────────────────────────────────────────

model Admin {
  id                   String       @id @default(cuid())
  name                 String
  email                String       @unique
  phoneNumber          String
  passwordHash         String
  profileImageUrl      String?
  profileImagePublicId String?
  role                 AdminRole    @default(ADMIN)
  permissions          Permission[]
  isActive             Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([isActive])
  @@map("admins")
}

// ─── Website Static Information ──────────────────────────────────────────────

model WebsiteSettings {
  id            Int      @id @default(1)
  businessHours String?
  contactEmail  String?
  logoUrl       String?
  logoPublicId  String?
  updatedAt     DateTime @updatedAt

  @@map("website_settings")
}

model WebsitePhone {
  id          String   @id @default(cuid())
  phoneNumber String
  label       String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
  @@map("website_phones")
}

model WebsiteAddress {
  id        String   @id @default(cuid())
  addressEn String
  addressAr String
  label     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("website_addresses")
}

model WebsiteMapLocation {
  id        String   @id @default(cuid())
  latitude  Decimal  @db.Decimal(10, 7)
  longitude Decimal  @db.Decimal(10, 7)
  label     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("website_map_locations")
}

model WebsiteSocialLink {
  id        String         @id @default(cuid())
  platform  SocialPlatform @unique
  url       String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("website_social_links")
}

// ─── Blog Categories & Blogs ─────────────────────────────────────────────────

model BlogCategory {
  id        String   @id @default(cuid())
  nameEn    String
  nameAr    String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  blogs     Blog[]

  @@map("blog_categories")
}

model Blog {
  id                     String       @id @default(cuid())
  authorName             String
  publishedAt            DateTime
  readingTimeMinutes     Int
  titleEn                String
  titleAr                String
  contentEn              String       @db.Text
  contentAr              String       @db.Text
  featuredImageUrl       String
  featuredImagePublicId  String
  attachmentUrl          String?
  attachmentPublicId     String?
  attachmentFormat       String?
  slug                   String       @unique
  categoryId             String
  category               BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  @@index([categoryId])
  @@index([publishedAt])
  @@map("blogs")
}

// ─── Service Categories & Services ───────────────────────────────────────────

model ServiceCategory {
  id        String    @id @default(cuid())
  nameEn    String
  nameAr    String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  services  Service[]

  @@map("service_categories")
}

model Service {
  id                    String                   @id @default(cuid())
  categoryId            String
  category              ServiceCategory          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  slug                  String                   @unique
  nameEn                String
  nameAr                String
  heroTitleEn           String
  heroTitleAr           String
  heroDescriptionEn     String                   @db.Text
  heroDescriptionAr     String                   @db.Text
  overviewTitleEn       String
  overviewTitleAr       String
  overviewDescriptionEn String                   @db.Text
  overviewDescriptionAr String                   @db.Text
  overviewImageUrl            String
  overviewImagePublicId       String
  strategicBenefitsImageUrl   String
  strategicBenefitsImagePublicId String
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  strategicBenefits     ServiceStrategicBenefit[]
  contactEnquiries      ContactEnquiry[]

  @@index([categoryId])
  @@map("services")
}

model ServiceStrategicBenefit {
  id            String  @id @default(cuid())
  serviceId     String
  service       Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  icon          String
  titleEn       String
  titleAr       String
  descriptionEn String  @db.Text
  descriptionAr String  @db.Text
  sortOrder     Int     @default(0)

  @@index([serviceId, sortOrder])
  @@map("service_strategic_benefits")
}

// ─── Contact Enquiries ───────────────────────────────────────────────────────

model ContactEnquiry {
  id          String        @id @default(cuid())
  name        String
  email       String
  phoneNumber String
  company     String?
  serviceId   String
  service     Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  country     String
  message     String        @db.Text
  status      EnquiryStatus @default(NEW)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([serviceId])
  @@index([createdAt])
  @@map("contact_enquiries")
}
